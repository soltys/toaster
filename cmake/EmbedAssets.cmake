# Generates a resource script and a C++ header that embed .wav sounds and
# images into the executable.
#
#   toaster_embed_assets(<target>
#       SOUNDS <file>...   # .wav / .mp3 files
#       IMAGES <file>...)  # .png / .jpg / .jpeg / .gif files
#
# Each asset is addressed at runtime by its file name without extension,
# lower-cased, with characters other than [a-z0-9_] replaced by '_'.
# Example: "Build-Done.wav" -> "build_done".

# Collects files with the given extensions from a folder (not recursive).
#   toaster_collect_assets(<out_var> <dir> <ext>...)
# An empty <dir> yields an empty list; a missing folder is an error.
function(toaster_collect_assets out_var dir)
    set(files "")
    if(NOT dir STREQUAL "")
        get_filename_component(abs_dir "${dir}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT IS_DIRECTORY "${abs_dir}")
            message(FATAL_ERROR "Asset folder not found: ${abs_dir}")
        endif()
        set(patterns "")
        foreach(ext IN LISTS ARGN)
            list(APPEND patterns "${abs_dir}/*.${ext}")
            string(TOUPPER "${ext}" upper)
            list(APPEND patterns "${abs_dir}/*.${upper}")
        endforeach()
        file(GLOB files CONFIGURE_DEPENDS ${patterns})
        list(REMOVE_DUPLICATES files)
        list(SORT files)
    endif()
    list(LENGTH files count)
    message(STATUS "toaster: embedding ${count} file(s) from '${dir}'")
    set(${out_var} "${files}" PARENT_SCOPE)
endfunction()

function(_toaster_asset_name out_var file)
    get_filename_component(stem "${file}" NAME_WE)
    string(TOLOWER "${stem}" stem)
    string(REGEX REPLACE "[^a-z0-9_]" "_" stem "${stem}")
    set(${out_var} "${stem}" PARENT_SCOPE)
endfunction()

function(toaster_embed_assets target)
    cmake_parse_arguments(ARG "" "" "SOUNDS;IMAGES" ${ARGN})

    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
    set(rc_file "${out_dir}/embedded_assets.rc")
    set(header_file "${out_dir}/embedded_assets.h")

    set(rc_content "// Generated by cmake/EmbedAssets.cmake. Do not edit.\n")
    set(sound_entries "")
    set(image_entries "")
    set(seen_sounds "")
    set(seen_images "")
    set(dependencies "")

    foreach(kind SOUNDS IMAGES)
        foreach(file IN LISTS ARG_${kind})
            get_filename_component(path "${file}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
            if(NOT EXISTS "${path}")
                message(FATAL_ERROR "Embedded asset not found: ${path}")
            endif()

            get_filename_component(ext "${path}" LAST_EXT)
            string(TOLOWER "${ext}" ext)
            _toaster_asset_name(name "${path}")
            if(name STREQUAL "")
                message(FATAL_ERROR "Cannot derive an asset name from: ${path}")
            endif()

            # The resource compiler treats backslashes in strings as escapes.
            file(TO_CMAKE_PATH "${path}" rc_path)
            list(APPEND dependencies "${path}")

            if(kind STREQUAL "SOUNDS")
                if(NOT ext MATCHES "^\\.(wav|mp3)$")
                    message(FATAL_ERROR "Embedded sounds must be .wav or .mp3 files: ${path}")
                endif()
                if(name IN_LIST seen_sounds)
                    message(FATAL_ERROR "Two embedded sounds share the name '${name}'")
                endif()
                list(APPEND seen_sounds "${name}")
                if(ext STREQUAL ".wav")
                    # Resource type WAVE lets PlaySound(SND_RESOURCE) play it directly.
                    string(APPEND rc_content "SND_${name} WAVE \"${rc_path}\"\n")
                else()
                    # MP3 is played by MCI from a file, so it is unpacked to the cache.
                    string(APPEND rc_content "SND_${name} RCDATA \"${rc_path}\"\n")
                endif()
                string(APPEND sound_entries "    EmbeddedAsset{L\"${name}\", L\"${ext}\"},\n")
            else()
                if(NOT ext MATCHES "^\\.(png|jpg|jpeg|gif)$")
                    message(FATAL_ERROR "Embedded images must be .png, .jpg, .jpeg or .gif: ${path}")
                endif()
                if(name IN_LIST seen_images)
                    message(FATAL_ERROR "Two embedded images share the name '${name}'")
                endif()
                list(APPEND seen_images "${name}")
                string(APPEND rc_content "IMG_${name} RCDATA \"${rc_path}\"\n")
                string(APPEND image_entries "    EmbeddedAsset{L\"${name}\", L\"${ext}\"},\n")
            endif()
        endforeach()
    endforeach()

    list(LENGTH seen_sounds sound_count)
    list(LENGTH seen_images image_count)

    set(header_content "// Generated by cmake/EmbedAssets.cmake. Do not edit.
#pragma once

#include <array>
#include <string_view>

namespace toaster::embedded {

struct EmbeddedAsset {
    std::wstring_view name;
    std::wstring_view extension; // including the dot, e.g. L\".png\"
};

// Resource names are \"SND_<name>\" (type WAVE for .wav, RCDATA for .mp3)
// and \"IMG_<name>\" (type RCDATA).
inline constexpr std::array<EmbeddedAsset, ${sound_count}> kSounds{
${sound_entries}};

inline constexpr std::array<EmbeddedAsset, ${image_count}> kImages{
${image_entries}};

} // namespace toaster::embedded
")

    # file(CONFIGURE) only rewrites when the content changes, avoiding rebuilds.
    file(CONFIGURE OUTPUT "${rc_file}" CONTENT "${rc_content}" @ONLY)
    file(CONFIGURE OUTPUT "${header_file}" CONTENT "${header_content}" @ONLY)

    target_sources(${target} PRIVATE "${rc_file}")
    target_include_directories(${target} PRIVATE "${out_dir}")
    # Re-run the resource compiler when an embedded file changes.
    set_source_files_properties("${rc_file}" PROPERTIES OBJECT_DEPENDS "${dependencies}")
endfunction()
