{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 3
    },
    "configurePresets": [
        {
            "name": "msvc-x64",
            "displayName": "MSVC x64 (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TOASTER_SOUNDS_DIR": "c:/temp/toast_notification/sounds",
        "TOASTER_IMAGES_DIR": "c:/temp/toast_notification/images"
      }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "msvc-x64",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "msvc-x64",
            "configuration": "Release"
        }
    ]
}
